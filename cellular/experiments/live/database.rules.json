{
  "rules": {
    "live": {
      ".read": true,
      "roles": {
        ".write": "auth != null && auth.uid === 'XK85kNrN8lPOq8jN8UzgEuMkJVt1'"
      },
      "cmd": {
        ".write": "auth != null && auth.uid === 'XK85kNrN8lPOq8jN8UzgEuMkJVt1'"
      },
      "fb": {
        ".write": "auth != null && auth.uid === 'XK85kNrN8lPOq8jN8UzgEuMkJVt1'"
      },
      "crowd": {
        ".write": "auth != null && auth.uid === 'XK85kNrN8lPOq8jN8UzgEuMkJVt1'"
      },
      "net": {
        ".write": "auth != null && auth.uid === 'XK85kNrN8lPOq8jN8UzgEuMkJVt1'"
      },
      "presence": {
        "$role": {
          ".validate": "$role === 'cosi' || $role === 'cimsi'",
          "$id": {
            ".write": true,
            ".validate": "newData.isBoolean() && $id.length <= 32"
          }
        }
      },
      "touch": {
        "$role": {
          ".validate": "$role === 'cosi' || $role === 'cimsi'",
          "$id": {
            ".write": true,
            ".validate": "newData.hasChildren(['t', 'n', 'm']) && $id.length <= 32",
            "t": { ".validate": "newData.isNumber() && newData.val() <= now + 5000" },
            "n": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() < 100000" },
            "m": { ".validate": "newData.isString() && newData.val().length <= 128" },
            "$other": { ".validate": false }
          }
        }
      }
    },
    "log": {
      ".read": "auth != null && auth.uid === 'XK85kNrN8lPOq8jN8UzgEuMkJVt1'",
      ".write": "auth != null && auth.uid === 'XK85kNrN8lPOq8jN8UzgEuMkJVt1'"
    }
  }
}
